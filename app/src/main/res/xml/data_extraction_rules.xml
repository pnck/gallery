<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ extraction rules — same exclusions as backup_rules.xml (which see
     for the rationale): encrypted stores are undecryptable after reinstall,
     DataStore flags/cursors go stale against the empty Room DB. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_store.xml" />
        <exclude domain="sharedpref" path="transport_store.xml" />
        <exclude domain="sharedpref" path="mydrive_auth.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_store.xml" />
        <exclude domain="sharedpref" path="transport_store.xml" />
        <exclude domain="sharedpref" path="mydrive_auth.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
